server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;
    error_page 404 /404.html;

    # Access control: allow the home LAN through with no prompt, require a
    # valid credential for everyone else. ALLOWED_CIDR and the credentials
    # (used to build /etc/nginx/.htpasswd, see docker-entrypoint.d/) come
    # from the container's environment (.env at deploy time) — never
    # committed to this repo. See nginx/README.md.
    satisfy any;

    allow ${ALLOWED_CIDR};
    deny all;

    auth_basic "Documentation";
    auth_basic_user_file /etc/nginx/.htpasswd;

    location / {
        try_files $uri $uri.html $uri/ =404;
    }

    # Immutable caching for content-hashed assets (see Quartz hosting docs)
    location ~* \.(css|js)$ {
        if ($uri ~* "-[0-9a-f]{8}\.") {
            add_header Cache-Control "public, max-age=31536000, immutable";
        }
    }
}
