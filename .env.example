# Copy to .env (never committed) and fill in real values on the deploy host.

# CIDR allowed through without a credential prompt (your home LAN).
ALLOWED_CIDR=192.168.1.0/24

# HTTP Basic Auth credentials required for anyone outside ALLOWED_CIDR.
# Leave unset to deny all non-LAN access (safe default).
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=
